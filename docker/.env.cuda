###
# CUDA specific settings
###
# CUDA version configuration - these can be modified to install different CUDA versions

# CUDA full version (e.g., 13.0.0, 12.2.0, 11.8.0)
CUDA_VERSION=13.0.0
# CUDA driver version that comes with the installer
CUDA_DRIVER_VERSION=580.65.06
# Architecture of the installer (linux_sbsa for ARM64, linux for x86_64)
CUDA_ARCH=linux_sbsa
# CUDA major version for installation path (e.g., 13.0, 12.2, 11.8)
CUDA_MAJOR_VERSION=13.0

# Docker image and container name suffix (default "", set by the container_interface.py script)
# Example: "-custom"
DOCKER_NAME_SUFFIX=""
