###
# cuRobo specific settings
###
# cuRobo requires CUDA 12.8, so we configure our CUDA dockerfile for that version

# CUDA 12.8 configuration for cuRobo
CUDA_VERSION=12.8.0
CUDA_DRIVER_VERSION=550.90.07
CUDA_ARCH=linux
CUDA_MAJOR_VERSION=12.8

# cuRobo specific environment
TORCH_CUDA_ARCH_LIST=8.0+PTX

# Docker image and container name suffix (default "", set by the container_interface.py script)
DOCKER_NAME_SUFFIX=""
